<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">New Draft</h1>

  <%= form_with(model: @post, class: "bg-white shadow rounded-lg p-6 space-y-6") do |form| %>
    <% if @post.errors.any? %>
      <div class="bg-red-100 text-red-800 px-4 py-3 rounded-lg">
        <h2 class="font-medium">Please fix the following errors:</h2>
        <ul class="list-disc list-inside mt-2">
          <% @post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :thread_account_id, "Account", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :thread_account_id, @accounts, :id, :username, { prompt: "Select account" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2", required: true %>
    </div>

    <div>
      <%= form.label :content, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :content, rows: 6, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 font-mono", required: true, placeholder: "Write your Threads post here..." %>
      <p class="mt-1 text-sm text-gray-500">Supports threads (multiple posts). Each line break creates a new thread item.</p>
    </div>

    <div>
      <%= form.label :media_url, "Media URL (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :media_url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2" %>
    </div>

    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to "Cancel", posts_path, class: "border border-gray-300 rounded-md px-3 py-1 text-sm hover:bg-gray-50" %>
      <%= form.submit "Save Draft", class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>