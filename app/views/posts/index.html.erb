<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Posts</h1>
  <%= link_to "New Draft", new_post_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
</div>

<div class="space-y-6">
  <!-- Draft Posts -->
  <section>
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-semibold text-gray-700">Drafts (<%= @draft_posts.size %>)</h2>
    </div>
    <% if @draft_posts.any? %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @draft_posts.each do |post| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900 max-w-xs truncate"><%= post.content %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.thread_account.username %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                  <%= link_to "View", post_path(post), class: "text-indigo-600 hover:text-indigo-900 text-sm" %>
                  <%= button_to "Approve", approve_post_path(post, scheduled_at: Time.current.iso8601), method: :patch, class: "px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No drafts</p>
    <% end %>
  </section>

  <!-- Queued Posts -->
  <section>
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-semibold text-gray-700">Queued (<%= @queued_posts.size %>)</h2>
    </div>
    <% if @queued_posts.any? %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scheduled</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @queued_posts.each do |post| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900 max-w-xs truncate"><%= post.content %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.thread_account.username %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.scheduled_at&.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold leading-5 text-yellow-800 bg-yellow-100 rounded-full">Queued</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No queued posts</p>
    <% end %>
  </section>

  <!-- Published Posts -->
  <section>
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-semibold text-gray-700">Published (<%= @published_posts.size %>)</h2>
    </div>
    <% if @published_posts.any? %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Published</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Threads ID</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @published_posts.each do |post| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900 max-w-xs truncate"><%= post.content %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.thread_account.username %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.published_at&.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono"><%= post.threads_post_id %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No published posts</p>
    <% end %>
  </section>

  <!-- Failed Posts -->
  <section>
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-semibold text-gray-700">Failed (<%= @failed_posts.size %>)</h2>
    </div>
    <% if @failed_posts.any? %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Error</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @failed_posts.each do |post| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-900 max-w-xs truncate"><%= post.content %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= post.thread_account.username %></td>
                <td class="px-6 py-4 text-sm text-red-600 max-w-md"><%= post.error_message %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">No failed posts</p>
    <% end %>
  </section>
</div>