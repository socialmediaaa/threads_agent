<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Threads Agent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Threads Agent">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="<%= root_path %>" class="text-xl font-bold text-indigo-600">Threads Agent</a>
          </div>
          <div class="flex items-center space-x-4">
            <%= link_to "Posts", posts_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Accounts", thread_accounts_path, class: "text-gray-700 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium" %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <% if flash.any? %>
        <div class="mb-6">
          <% flash.each do |type, message| %>
            <div class="<%= flash_class(type) %> px-4 py-3 rounded-lg" role="alert">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>

<% def flash_class(type)
  case type.to_s
  when "notice" then "bg-green-100 text-green-800"
  when "alert" then "bg-red-100 text-red-800"
  else "bg-blue-100 text-blue-800"
  end
end %>