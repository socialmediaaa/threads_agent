<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Thread Accounts</h1>
  <%= link_to "Add Account", new_thread_account_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
</div>

<% if @accounts.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Threads User ID</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Token Expires</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @accounts.each do |account| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= account.username %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= account.threads_user_id %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= account.token_expires_at&.strftime("%Y-%m-%d %H:%M") %>
              <% if account.token_expired? %>
                <span class="ml-2 text-red-600 text-xs">(expired)</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= account.created_at.strftime("%Y-%m-%d") %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= button_to "Remove", thread_account_path(account), method: :delete, data: { turbo_confirm: "Remove this account?" }, class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white rounded-lg shadow p-8 text-center">
    <p class="text-gray-500 mb-4">No accounts yet</p>
    <%= link_to "Add your first account", new_thread_account_path, class: "text-indigo-600 hover:text-indigo-900" %>
  </div>
<% end %>