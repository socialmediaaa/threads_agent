<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Add Thread Account</h1>

  <%= form_with(model: @account, class: "bg-white shadow rounded-lg p-6 space-y-6") do |form| %>
    <% if @account.errors.any? %>
      <div class="bg-red-100 text-red-800 px-4 py-3 rounded-lg">
        <h2 class="font-medium">Please fix the following errors:</h2>
        <ul class="list-disc list-inside mt-2">
          <% @account.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :threads_user_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :threads_user_id, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2", required: true %>
    </div>

    <div>
      <%= form.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :username, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2", required: true %>
    </div>

    <div>
      <%= form.label :access_token, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :access_token, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2", required: true %>
      <p class="mt-1 text-sm text-gray-500">Long-lived access token from Meta Graph API</p>
    </div>

    <div>
      <%= form.label :token_expires_at, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.datetime_local_field :token_expires_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2" %>
    </div>

    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to "Cancel", thread_accounts_path, class: "border border-gray-300 rounded-md px-3 py-1 text-sm hover:bg-gray-50" %>
      <%= form.submit "Save Account", class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>